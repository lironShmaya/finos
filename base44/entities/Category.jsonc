{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "section": {
      "type": "string",
      "enum": [
        "income",
        "expenses",
        "bills",
        "subscriptions",
        "savings"
      ],
      "default": "expenses",
      "description": "Budget section this category belongs to"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent category ID for subcategories"
    },
    "type": {
      "type": "string",
      "enum": [
        "essentials",
        "discretionary",
        "investment",
        "bills",
        "debt",
        "income",
        "transfer"
      ],
      "description": "Category classification"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "color": {
      "type": "string",
      "description": "Hex color for charts"
    },
    "ordering": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name",
    "type"
  ]
}