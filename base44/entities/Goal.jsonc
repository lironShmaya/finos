{
  "name": "Goal",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "emergency_fund",
        "house_down_payment",
        "vacation",
        "retirement",
        "education",
        "custom"
      ],
      "default": "custom"
    },
    "person_scope": {
      "type": "string",
      "enum": [
        "household",
        "personal"
      ],
      "default": "household"
    },
    "person_id": {
      "type": "string"
    },
    "person_name": {
      "type": "string"
    },
    "target_amount": {
      "type": "number"
    },
    "current_amount": {
      "type": "number",
      "default": 0
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "monthly_contribution": {
      "type": "number",
      "default": 0
    },
    "expected_return": {
      "type": "number",
      "default": 0,
      "description": "Expected annual return %"
    },
    "priority": {
      "type": "number",
      "default": 3,
      "description": "Priority 1-5"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "ILS",
        "EUR",
        "GBP"
      ],
      "default": "USD"
    },
    "linked_account_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "color": {
      "type": "string",
      "default": "#10B981"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "target_amount"
  ]
}